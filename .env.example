DATABASE_URL="postgresql://user:pass@localhost:5432/givar"
DIRECT_URL="postgresql://user:pass@localhost:5432/givar" # Direct Postgres connection used by Prisma introspection/schema changes
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="https://givar.app"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FLUTTERWAVE_SECRET=""
FLUTTERWAVE_SECRET_HASH=""   # webhook verif-hash you set in the dashboard
PAYSTACK_SECRET=""
STROWALLET_KEY=""  # Legacy provider key; USD virtual-account funding is disabled (USD deposits are crypto-only).
STRIPE_SECRET_KEY=""  # Reserved; this codebase does not currently implement Stripe checkout/webhooks.
# Leave provider keys empty to run with mocked virtual accounts
FLUTTERWAVE_BASE="https://api.flutterwave.com/v3"
CRON_SECRET=""               # protects /api/cron/draw-contests
STROWALLET_WEBHOOK_SECRET=""  # shared secret/header value configured with the provider
RESEND_API_KEY=""            # email (verification + password reset)
EMAIL_FROM="Givar <no-reply@givar.app>"
TWILIO_SID=""                # SMS codes for phone verification
TWILIO_TOKEN=""
TWILIO_FROM=""
TEST_DATABASE_URL=""         # a DISPOSABLE Postgres, only for `npm test` integration tests
NOWPAYMENTS_API_KEY=""        # crypto deposits (leave empty for dev mode with a fake address)
NOWPAYMENTS_IPN_SECRET=""

# Make yourself an admin: your email here (comma-separated for more), then sign in. The email must be verified (Google sign-in does this).
ADMIN_EMAILS=""

# Supabase Storage for profile pictures, branding assets and APK releases (server-only service key).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
